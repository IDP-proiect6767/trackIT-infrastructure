# ============================================================
# TrackIT Infrastructure — root .env.example
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# --- Postgres: Auth DB ---
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=change-me
AUTH_DB_NAME=auth_db

# --- Postgres: Data DB ---
DATA_DB_USER=data_user
DATA_DB_PASSWORD=change-me
DATA_DB_NAME=data_db

# --- Auth Service ---
AUTH_JWT_SECRET=change-me-change-me-change-me-change-me

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@trackit.com
PGADMIN_DEFAULT_PASSWORD=change-me

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=change-me

# --- Portainer ---
PORTAINER_ADMIN_PASSWORD=change-me

# --- Image tags (optional; defaults to :latest) ---
AUTH_IMAGE_TAG=latest
BUSINESS_IMAGE_TAG=latest
DATA_IMAGE_TAG=latest
